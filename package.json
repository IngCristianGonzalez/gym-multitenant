{
  "name": "gym-multitenant",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema multiempresa de gestión de gimnasios (NestJS + PostgreSQL + React)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@gym/api",
    "dev:web": "turbo run dev --filter=@gym/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "turbo run db:generate --filter=@gym/api",
    "db:push": "turbo run db:push --filter=@gym/api",
    "db:seed": "turbo run db:seed --filter=@gym/api",
    "db:studio": "turbo run db:studio --filter=@gym/api"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.3",
    "eslint": "^9.13.0"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
